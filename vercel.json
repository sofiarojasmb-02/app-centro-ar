{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/models/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|models/|images/|icons/|favicon\\.svg|.*\\..*).*)$",
      "destination": "/index.html"
    }
  ]
}
